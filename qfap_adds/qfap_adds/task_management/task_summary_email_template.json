{
  "name": "Farabi Configurable Task Summary v2",
  "subject": "{{ frequency }} Task Summary | {{ employee_name }} | {{ period_label }}",
  "use_html": 1,
  "response_html": "<div style=\"margin:0;padding:0;background:#f4f6f8;font-family:Arial,Tahoma,sans-serif;color:#28323c;\">\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"background:#f4f6f8;\"><tr><td align=\"center\" style=\"padding:24px 10px;\">\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"max-width:1000px;background:#ffffff;border:1px solid {{ border_color }};border-radius:12px;overflow:hidden;\">\n<tr><td style=\"padding:24px 28px;background:{{ header_color }};color:#ffffff;\">\n<table role=\"presentation\" width=\"100%\"><tr>\n<td style=\"vertical-align:middle;\">{% if company_logo %}<img src=\"{{ company_logo }}\" alt=\"{{ company }}\" style=\"display:block;max-width:170px;max-height:60px;margin-bottom:12px;\">{% endif %}<div style=\"font-size:23px;font-weight:700;line-height:1.3;\">{{ frequency }} Task Summary</div><div style=\"font-size:12px;opacity:.9;margin-top:5px;\">{{ period_label }}</div></td>\n<td align=\"right\" style=\"vertical-align:middle;font-size:13px;line-height:1.7;\"><strong>{{ company }}</strong><br>{{ report_date }}</td>\n</tr></table></td></tr>\n<tr><td style=\"padding:22px 28px 8px;\">\n<table role=\"presentation\" width=\"100%\" style=\"background:{{ light_color }};border:1px solid {{ border_color }};border-radius:8px;\"><tr><td style=\"padding:15px 18px;\"><div style=\"font-size:17px;font-weight:700;color:{{ primary_color }};\">{{ employee_name }}</div><div style=\"font-size:12px;color:#667582;margin-top:4px;\">{{ designation }}{% if designation and department %} &nbsp;|&nbsp; {% endif %}{{ department }}</div></td></tr></table>\n</td></tr>\n<tr><td style=\"padding:14px 28px 4px;\">\n<table role=\"presentation\" width=\"100%\" cellspacing=\"8\" cellpadding=\"0\"><tr>\n{% set cards = [(\"Operational\", operational_task_count), (\"Main Tasks\", main_task_count), (\"Active\", active_tasks), (\"Completed\", completed_tasks), (\"Overdue\", overdue_count), (\"Due Soon\", due_soon_count)] %}\n{% for label, value in cards %}<td width=\"16.6%\" align=\"center\" style=\"padding:13px 5px;background:{{ light_color }};border:1px solid {{ border_color }};border-radius:8px;\"><div style=\"font-size:20px;font-weight:700;color:{% if label == 'Overdue' and value %}#b42318{% elif label == 'Due Soon' and value %}#9a6700{% else %}{{ primary_color }}{% endif %};\">{{ value }}</div><div style=\"font-size:10px;color:#667582;margin-top:4px;\">{{ label }}</div></td>{% endfor %}\n</tr></table></td></tr>\n<tr><td style=\"padding:4px 28px 18px;\"><table role=\"presentation\" width=\"100%\" cellspacing=\"8\"><tr>\n<td width=\"25%\" align=\"center\" style=\"padding:12px;border:1px solid {{ border_color }};border-radius:8px;\"><b style=\"color:{{ primary_color }};\">{{ average_progress }}%</b><br><span style=\"font-size:10px;color:#667582;\">Average Progress</span></td>\n<td width=\"25%\" align=\"center\" style=\"padding:12px;border:1px solid {{ border_color }};border-radius:8px;\"><b style=\"color:{{ primary_color }};\">{{ expected_hours }}</b><br><span style=\"font-size:10px;color:#667582;\">Expected Hours</span></td>\n<td width=\"25%\" align=\"center\" style=\"padding:12px;border:1px solid {{ border_color }};border-radius:8px;\"><b style=\"color:{{ accent_color }};\">{{ actual_hours }}</b><br><span style=\"font-size:10px;color:#667582;\">Actual Hours</span></td>\n<td width=\"25%\" align=\"center\" style=\"padding:12px;border:1px solid {{ border_color }};border-radius:8px;\"><b style=\"color:{% if hours_variance > 0 %}#b42318{% else %}#18794e{% endif %};\">{{ hours_variance }}</b><br><span style=\"font-size:10px;color:#667582;\">Hours Variance</span></td>\n</tr></table></td></tr>\n{% macro task_table(title, rows, hidden_count) %}{% if rows %}<tr><td style=\"padding:4px 28px 20px;\"><div style=\"padding:10px 14px;background:{{ primary_color }};color:#fff;font-size:14px;font-weight:700;border-radius:7px 7px 0 0;\">{{ title }} <span style=\"font-weight:400;opacity:.85;\">({{ rows|length }})</span></div><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"border-collapse:collapse;font-size:11px;\"><thead><tr>{% for key, label in columns %}<th align=\"left\" style=\"padding:9px 8px;background:{{ light_color }};border:1px solid {{ border_color }};color:{{ primary_color }};\">{{ label }}</th>{% endfor %}</tr></thead><tbody>{% for task in rows %}<tr style=\"background:{% if loop.index is even %}{{ light_color }}{% else %}#ffffff{% endif %};\">{% for key, label in columns %}<td style=\"padding:9px 8px;border:1px solid {{ border_color }};vertical-align:top;\">{% if key == 'subject' %}<a href=\"{{ task.task_url }}\" style=\"color:{{ primary_color }};font-weight:700;text-decoration:none;\">{{ task.subject }}</a>{% elif key == 'status' %}<span style=\"display:inline-block;padding:3px 7px;border-radius:10px;background:{{ task.status_style.background }};color:{{ task.status_style.color }};font-weight:700;\">{{ task.status_style.label }}</span>{% elif key == 'progress' %}{{ task.progress or 0 }}%{% else %}{{ task.get(key) or '' }}{% endif %}</td>{% endfor %}</tr>{% endfor %}</tbody></table>{% if hidden_count %}<div style=\"padding:9px 12px;background:{{ light_color }};border:1px solid {{ border_color }};border-top:0;color:#667582;font-size:10px;\">{{ hidden_count }} additional task(s) are available in Employees Task Tracker.</div>{% endif %}</td></tr>{% endif %}{% endmacro %}\n{% if detail_level == 'Summary and Attention Tasks' %}{{ task_table('Tasks Requiring Attention', attention_tasks, attention_hidden_count) }}{% elif detail_level == 'Full Task Details' %}{{ task_table('Tasks Requiring Attention', attention_tasks, attention_hidden_count) }}{{ task_table('Operational Tasks', operational_tasks, operational_hidden_count) }}{{ task_table('Main Tasks', main_tasks, main_hidden_count) }}{% endif %}\n<tr><td align=\"center\" style=\"padding:10px 28px 26px;\"><a href=\"{{ report_url }}\" style=\"display:inline-block;padding:12px 24px;background:{{ primary_color }};color:#ffffff;text-decoration:none;border-radius:7px;font-weight:700;font-size:13px;\">Open Employees Task Tracker</a></td></tr>\n<tr><td align=\"center\" style=\"padding:14px 20px;background:{{ light_color }};border-top:1px solid {{ border_color }};color:#6b7884;font-size:10px;\">Automated Task Management summary from {{ company }}. Please update Task progress and actual hours in the system.</td></tr>\n</table></td></tr></table></div>"
}
