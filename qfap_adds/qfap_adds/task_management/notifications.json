[
  {
    "doctype": "Notification",
    "name": "Supervisor Remark on Employee Task",
    "subject": "ملاحظة جديدة من المشرف | New Supervisor Remark: {{ doc.subject or doc.name }}",
    "document_type": "Task",
    "event": "Value Change",
    "channel": "Email",
    "enabled": 1,
    "condition": "not doc.custom_project_workplan and doc.custom_assign_to and doc.custom_supervisor_remarks and doc.custom_user_id and doc.modified_by != doc.custom_user_id",
    "message_type": "HTML",
    "message": "<!--\r\nSUPERVISOR REMARK ON TASK - BILINGUAL PROFESSIONAL\r\nDocument Type: Task\r\nChannel: Email\r\nEvent: Value Change\r\nValue Changed: custom_supervisor_remarks\r\nCondition:\r\ndoc.custom_project_workplan == 0 and doc.custom_assign_to and doc.custom_supervisor_remarks and doc.custom_assignee_email\r\nRecipient: By Document Field > custom_assignee_email\r\nMessage Type: HTML\r\n-->\r\n\r\n{% set task_url = frappe.get_url() + \"/app/task/\" + doc.name %}\r\n{% set employee_display = frappe.db.get_value(\"Employee\", doc.custom_assign_to, \"employee_name\") or doc.custom_assign_to or \"\" %}\r\n{% set supervisor_display = frappe.db.get_value(\"Employee\", {\"user_id\": doc.modified_by}, \"employee_name\") or doc.modified_by or \"\" %}\r\n{% set project_display = frappe.db.get_value(\"Project\", doc.project, \"project_name\") or doc.project or \"\" %}\r\n\r\n<div style=\"margin:0;padding:0;background-color:#eef3f6;font-family:Arial,Tahoma,sans-serif;color:#243342;line-height:1.65;\">\r\n  <div style=\"display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;\">\r\n    أضاف المشرف ملاحظة جديدة على المهمة {{ doc.subject or doc.name }}. A supervisor added a new remark to task {{ doc.subject or doc.name }}.\r\n  </div>\r\n\r\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"width:100%;border-collapse:collapse;background-color:#eef3f6;\">\r\n    <tr><td align=\"center\" style=\"padding:28px 10px;\">\r\n      <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"width:100%;max-width:840px;border-collapse:separate;border-spacing:0;background-color:#ffffff;border:1px solid #d7e1e6;border-radius:14px;overflow:hidden;box-shadow:0 8px 24px rgba(25,65,82,0.08);\">\r\n        <tr><td style=\"padding:0;background-color:#155f78;\">\r\n          <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"width:100%;border-collapse:collapse;\"><tr>\r\n            <td style=\"width:8px;background-color:#efb43c;font-size:1px;line-height:1px;\">&nbsp;</td>\r\n            <td align=\"center\" style=\"padding:30px 24px 26px;text-align:center;\">\r\n              <div style=\"display:inline-block;width:64px;height:64px;line-height:64px;border-radius:50%;background-color:#ffffff;border:3px solid #8dc1d1;color:#155f78;font-size:31px;text-align:center;\">💬</div>\r\n              <div style=\"margin-top:14px;color:#ffffff;font-size:23px;font-weight:700;direction:rtl;\">ملاحظة جديدة من المشرف</div>\r\n              <div style=\"margin-top:4px;color:#dcedf2;font-size:15px;font-weight:600;direction:ltr;letter-spacing:0.2px;\">New Supervisor Remark on Your Task</div>\r\n              <div style=\"display:inline-block;margin-top:15px;padding:7px 18px;border-radius:20px;background-color:#ffffff;color:#155f78;font-size:15px;font-weight:700;\">{{ employee_display }}</div>\r\n            </td>\r\n          </tr></table>\r\n        </td></tr>\r\n\r\n        <tr><td style=\"padding:28px 30px 30px;\">\r\n          <div style=\"direction:rtl;text-align:right;font-size:14px;color:#334650;\">\r\n            <p style=\"margin:0 0 10px;font-weight:700;color:#183f4e;\">الزميل/الزميلة {{ employee_display }}،</p>\r\n            <p style=\"margin:0 0 12px;\">أضاف المشرف <strong style=\"color:#155f78;\">{{ supervisor_display }}</strong> ملاحظة جديدة على مهمتك بعنوان <strong style=\"color:#155f78;\">{{ doc.subject or doc.name }}</strong>.</p>\r\n            <p style=\"margin:0;\">يرجى مراجعة الملاحظة أدناه، ثم فتح المهمة واتخاذ الإجراء المناسب وتحديث بيانات التنفيذ عند الحاجة.</p>\r\n          </div>\r\n\r\n          <div style=\"height:1px;margin:20px 0;background-color:#dfe7eb;\"></div>\r\n\r\n          <div style=\"direction:ltr;text-align:left;font-size:14px;color:#334650;\">\r\n            <p style=\"margin:0 0 10px;font-weight:700;color:#183f4e;\">Dear {{ employee_display }},</p>\r\n            <p style=\"margin:0 0 12px;\"><strong style=\"color:#155f78;\">{{ supervisor_display }}</strong> added a new remark to your task titled <strong style=\"color:#155f78;\">{{ doc.subject or doc.name }}</strong>.</p>\r\n            <p style=\"margin:0;\">Please review the remark below, open the task, take the appropriate action, and update the task information when necessary.</p>\r\n          </div>\r\n\r\n          <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"width:100%;margin-top:24px;border-collapse:separate;border-spacing:8px;table-layout:fixed;\"><tr>\r\n            <td style=\"padding:14px 15px;border:1px solid #d8e5ea;border-radius:8px;background-color:#f4f9fb;vertical-align:top;\">\r\n              <div style=\"font-size:11px;color:#6a7b84;direction:rtl;\">المهمة | Task</div>\r\n              <div style=\"margin-top:4px;font-size:14px;font-weight:700;color:#183f4e;\">{{ doc.subject or doc.name }}</div>\r\n            </td>\r\n            <td style=\"padding:14px 15px;border:1px solid #d8e5ea;border-radius:8px;background-color:#f4f9fb;vertical-align:top;\">\r\n              <div style=\"font-size:11px;color:#6a7b84;direction:rtl;\">المشرف | Supervisor</div>\r\n              <div style=\"margin-top:4px;font-size:14px;font-weight:700;color:#183f4e;\">{{ supervisor_display }}</div>\r\n            </td>\r\n            <td style=\"padding:14px 15px;border:1px solid #d8e5ea;border-radius:8px;background-color:#f4f9fb;vertical-align:top;\">\r\n              <div style=\"font-size:11px;color:#6a7b84;direction:rtl;\">الحالة | Status</div>\r\n              <div style=\"margin-top:4px;font-size:14px;font-weight:700;color:#155f78;\">{{ doc.status or \"Open\" }}</div>\r\n            </td>\r\n          </tr></table>\r\n\r\n          <div style=\"margin-top:22px;padding:9px 14px;border-radius:7px 7px 0 0;background-color:#155f78;color:#ffffff;font-size:15px;font-weight:700;text-align:center;\">ملاحظة المشرف | Supervisor Remark</div>\r\n          <div style=\"padding:18px 20px;border:1px solid #d9e2e7;border-top:0;border-radius:0 0 8px 8px;background-color:#f8fbfc;color:#263f49;font-size:14px;line-height:1.8;white-space:pre-wrap;\">\r\n            {{ (doc.custom_supervisor_remarks or \"\") | e }}\r\n          </div>\r\n\r\n          <div style=\"margin-top:22px;padding:9px 14px;border-radius:7px 7px 0 0;background-color:#155f78;color:#ffffff;font-size:15px;font-weight:700;text-align:center;\">معلومات المهمة | Task Information</div>\r\n          <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"width:100%;border-collapse:collapse;border:1px solid #d9e2e7;font-size:13px;\">\r\n            <tr><td style=\"width:34%;padding:10px 12px;background-color:#f6f8f9;border:1px solid #d9e2e7;font-weight:700;\">رمز المهمة | Task ID</td><td style=\"padding:10px 12px;border:1px solid #d9e2e7;direction:ltr;text-align:left;\">{{ doc.name }}</td></tr>\r\n            <tr><td style=\"padding:10px 12px;background-color:#f6f8f9;border:1px solid #d9e2e7;font-weight:700;\">المشروع | Project</td><td style=\"padding:10px 12px;border:1px solid #d9e2e7;\">{{ project_display }}</td></tr>\r\n            <tr><td style=\"padding:10px 12px;background-color:#f6f8f9;border:1px solid #d9e2e7;font-weight:700;\">الأولوية | Priority</td><td style=\"padding:10px 12px;border:1px solid #d9e2e7;\">{{ doc.priority or \"\" }}</td></tr>\r\n            <tr><td style=\"padding:10px 12px;background-color:#f6f8f9;border:1px solid #d9e2e7;font-weight:700;\">نسبة الإنجاز | Progress</td><td style=\"padding:10px 12px;border:1px solid #d9e2e7;\">{{ doc.progress or 0 }}%</td></tr>\r\n            <tr><td style=\"padding:10px 12px;background-color:#f6f8f9;border:1px solid #d9e2e7;font-weight:700;\">النهاية المتوقعة | Expected End</td><td style=\"padding:10px 12px;border:1px solid #d9e2e7;direction:ltr;text-align:left;\">{% if doc.exp_end_date %}{{ frappe.format(doc.exp_end_date, {\"fieldtype\":\"Datetime\"}) }}{% else %}Not specified{% endif %}</td></tr>\r\n          </table>\r\n\r\n          <div style=\"margin-top:22px;padding:14px 16px;border:1px solid #e7c978;border-left:5px solid #efb43c;border-radius:7px;background-color:#fff9e8;color:#665420;font-size:12px;text-align:center;\">\r\n            <div style=\"direction:rtl;font-weight:700;\">الإجراء المطلوب: راجع ملاحظة المشرف، ونفّذ الإجراء المطلوب، ثم حدّث المهمة.</div>\r\n            <div style=\"direction:ltr;margin-top:4px;\">Required action: Review the supervisor's remark, take the required action, and update the task.</div>\r\n          </div>\r\n\r\n          <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"width:100%;margin-top:22px;border-collapse:collapse;\"><tr><td align=\"center\" style=\"text-align:center;\">\r\n            <a href=\"{{ task_url }}\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"display:inline-block;padding:13px 27px;border:1px solid #155f78;border-radius:7px;background-color:#155f78;color:#ffffff !important;font-family:Arial,Tahoma,sans-serif;font-size:13px;font-weight:700;line-height:1.45;text-align:center;text-decoration:none !important;box-shadow:0 3px 8px rgba(21,95,120,0.18);\">فتح المهمة ومراجعة الملاحظة<br><span style=\"font-size:11px;font-weight:600;\">Open Task and Review Remark</span></a>\r\n          </td></tr></table>\r\n\r\n          <div style=\"margin-top:12px;color:#71818a;font-size:10px;line-height:1.5;text-align:center;word-break:break-all;\">\r\n            <div style=\"direction:rtl;\">إذا لم يعمل الزر، استخدم الرابط التالي:</div>\r\n            <div style=\"direction:ltr;margin-top:2px;\">If the button does not work, use the following link:</div>\r\n            <div style=\"direction:ltr;margin-top:5px;\"><a href=\"{{ task_url }}\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#155f78;text-decoration:underline;word-break:break-all;\">{{ task_url }}</a></div>\r\n          </div>\r\n\r\n          <div style=\"margin-top:25px;padding-top:16px;border-top:1px solid #dfe7eb;text-align:center;\">\r\n            <strong style=\"color:#155f78;font-size:15px;\">{{ doc.company or \"\" }}</strong>\r\n            <div style=\"margin-top:3px;color:#72818a;font-size:12px;\">إدارة المهام | Task Management</div>\r\n          </div>\r\n        </td></tr>\r\n\r\n        <tr><td style=\"padding:13px 18px;background-color:#f3f6f8;border-top:1px solid #dde5e9;text-align:center;color:#78868e;font-size:10.5px;\">\r\n          <div style=\"direction:rtl;\">إشعار آلي صادر من نظام إدارة المهام. يرجى عدم مشاركة رابط المهمة خارج فريق العمل المخول.</div>\r\n          <div style=\"direction:ltr;margin-top:2px;\">Automated Task Management notification. Please do not share the task link outside the authorized team.</div>\r\n        </td></tr>\r\n      </table>\r\n    </td></tr>\r\n  </table>\r\n</div>\r\n",
    "send_system_notification": 0,
    "recipients": [
      {
        "receiver_by_document_field": "custom_user_id"
      }
    ]
  },
  {
    "doctype": "Notification",
    "name": "Task Assigned to Employee",
    "subject": "مهمة جديدة مسندة إليك | New Task Assigned: {{ doc.subject or doc.name }}",
    "document_type": "Task",
    "event": "New",
    "channel": "Email",
    "enabled": 1,
    "condition": "not doc.custom_project_workplan and not doc.custom_self_assigned and doc.custom_assign_to and doc.custom_task_assigned_by and doc.custom_user_id and doc.custom_user_id != doc.owner",
    "message_type": "HTML",
    "message": "<!--\r\nTASK ASSIGNED NOTIFICATION - BILINGUAL PROFESSIONAL\r\nDocument Type: Task\r\nChannel: Email\r\nEvent: New\r\nCondition:\r\nnot doc.custom_project_workplan and not doc.custom_self_assigned and doc.custom_assign_to and doc.custom_task_assigned_by and doc.custom_user_id\r\nRecipient: By Document Field > custom_user_id\r\nMessage Type: HTML\r\n-->\r\n\r\n{% set task_url = frappe.get_url() + \"/app/task/\" + doc.name %}\r\n{% set employee_display = frappe.db.get_value(\"Employee\", doc.custom_assign_to, \"employee_name\") or doc.custom_assign_to or \"\" %}\r\n{% set assigner_display = frappe.db.get_value(\"Employee\", doc.custom_task_assigned_by, \"employee_name\") or doc.custom_task_assigned_by or \"\" %}\r\n{% set project_display = frappe.db.get_value(\"Project\", doc.project, \"project_name\") or doc.project or \"\" %}\r\n\r\n<div style=\"margin:0;padding:0;background-color:#eef3f6;font-family:Arial,Tahoma,sans-serif;color:#243342;line-height:1.65;\">\r\n  <div style=\"display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;\">\r\n    تم إسناد مهمة جديدة إليك: {{ doc.subject or doc.name }}. A new task has been assigned to you: {{ doc.subject or doc.name }}.\r\n  </div>\r\n\r\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"width:100%;border-collapse:collapse;background-color:#eef3f6;\">\r\n    <tr><td align=\"center\" style=\"padding:28px 10px;\">\r\n      <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"width:100%;max-width:840px;border-collapse:separate;border-spacing:0;background-color:#ffffff;border:1px solid #d7e1e6;border-radius:14px;overflow:hidden;box-shadow:0 8px 24px rgba(25,65,82,0.08);\">\r\n        <tr><td style=\"padding:0;background-color:#155f78;\">\r\n          <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"width:100%;border-collapse:collapse;\"><tr>\r\n            <td style=\"width:8px;background-color:#efb43c;font-size:1px;line-height:1px;\">&nbsp;</td>\r\n            <td align=\"center\" style=\"padding:30px 24px 26px;text-align:center;\">\r\n              <div style=\"display:inline-block;width:64px;height:64px;line-height:64px;border-radius:50%;background-color:#ffffff;border:3px solid #8dc1d1;color:#155f78;font-size:31px;text-align:center;\">✅</div>\r\n              <div style=\"margin-top:14px;color:#ffffff;font-size:23px;font-weight:700;direction:rtl;\">تم إسناد مهمة جديدة إليك</div>\r\n              <div style=\"margin-top:4px;color:#dcedf2;font-size:15px;font-weight:600;direction:ltr;letter-spacing:0.2px;\">A New Task Has Been Assigned to You</div>\r\n              <div style=\"display:inline-block;margin-top:15px;padding:7px 18px;border-radius:20px;background-color:#ffffff;color:#155f78;font-size:15px;font-weight:700;\">{{ employee_display }}</div>\r\n            </td>\r\n          </tr></table>\r\n        </td></tr>\r\n\r\n        <tr><td style=\"padding:28px 30px 30px;\">\r\n          <div style=\"direction:rtl;text-align:right;font-size:14px;color:#334650;\">\r\n            <p style=\"margin:0 0 10px;font-weight:700;color:#183f4e;\">الزميل/الزميلة {{ employee_display }}،</p>\r\n            <p style=\"margin:0 0 12px;\">قام المشرف <strong style=\"color:#155f78;\">{{ assigner_display }}</strong> بإنشاء مهمة جديدة وإسنادها إليك بعنوان <strong style=\"color:#155f78;\">{{ doc.subject or doc.name }}</strong>.</p>\r\n            <p style=\"margin:0;\">يرجى مراجعة تفاصيل المهمة ومتطلباتها وتواريخها، ثم البدء في تنفيذها وتحديث حالتها ونسبة الإنجاز بصورة منتظمة.</p>\r\n          </div>\r\n\r\n          <div style=\"height:1px;margin:20px 0;background-color:#dfe7eb;\"></div>\r\n\r\n          <div style=\"direction:ltr;text-align:left;font-size:14px;color:#334650;\">\r\n            <p style=\"margin:0 0 10px;font-weight:700;color:#183f4e;\">Dear {{ employee_display }},</p>\r\n            <p style=\"margin:0 0 12px;\"><strong style=\"color:#155f78;\">{{ assigner_display }}</strong> has created and assigned a new task to you titled <strong style=\"color:#155f78;\">{{ doc.subject or doc.name }}</strong>.</p>\r\n            <p style=\"margin:0;\">Please review the task requirements and schedule, begin the required work, and keep the task status and progress updated.</p>\r\n          </div>\r\n\r\n          <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"width:100%;margin-top:24px;border-collapse:separate;border-spacing:8px;table-layout:fixed;\"><tr>\r\n            <td style=\"padding:14px 15px;border:1px solid #d8e5ea;border-radius:8px;background-color:#f4f9fb;vertical-align:top;\">\r\n              <div style=\"font-size:11px;color:#6a7b84;direction:rtl;\">الموظف المكلف | Assigned Employee</div>\r\n              <div style=\"margin-top:4px;font-size:14px;font-weight:700;color:#183f4e;\">{{ employee_display }}</div>\r\n            </td>\r\n            <td style=\"padding:14px 15px;border:1px solid #d8e5ea;border-radius:8px;background-color:#f4f9fb;vertical-align:top;\">\r\n              <div style=\"font-size:11px;color:#6a7b84;direction:rtl;\">أُسندت بواسطة | Assigned By</div>\r\n              <div style=\"margin-top:4px;font-size:14px;font-weight:700;color:#183f4e;\">{{ assigner_display }}</div>\r\n            </td>\r\n            <td style=\"padding:14px 15px;border:1px solid #d8e5ea;border-radius:8px;background-color:#f4f9fb;vertical-align:top;\">\r\n              <div style=\"font-size:11px;color:#6a7b84;direction:rtl;\">الأولوية | Priority</div>\r\n              <div style=\"margin-top:4px;font-size:14px;font-weight:700;color:#155f78;\">{{ doc.priority or \"Not specified\" }}</div>\r\n            </td>\r\n          </tr></table>\r\n\r\n          <div style=\"margin-top:22px;padding:9px 14px;border-radius:7px 7px 0 0;background-color:#155f78;color:#ffffff;font-size:15px;font-weight:700;text-align:center;\">تفاصيل المهمة | Task Details</div>\r\n          <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"width:100%;border-collapse:collapse;border:1px solid #d9e2e7;font-size:13px;\">\r\n            <tr><td style=\"width:34%;padding:10px 12px;background-color:#f6f8f9;border:1px solid #d9e2e7;font-weight:700;\">رمز المهمة | Task ID</td><td style=\"padding:10px 12px;border:1px solid #d9e2e7;direction:ltr;text-align:left;\">{{ doc.name }}</td></tr>\r\n            <tr><td style=\"padding:10px 12px;background-color:#f6f8f9;border:1px solid #d9e2e7;font-weight:700;\">عنوان المهمة | Task Subject</td><td style=\"padding:10px 12px;border:1px solid #d9e2e7;\">{{ doc.subject or \"\" }}</td></tr>\r\n            <tr><td style=\"padding:10px 12px;background-color:#f6f8f9;border:1px solid #d9e2e7;font-weight:700;\">المشروع | Project</td><td style=\"padding:10px 12px;border:1px solid #d9e2e7;\">{{ project_display }}</td></tr>\r\n            <tr><td style=\"padding:10px 12px;background-color:#f6f8f9;border:1px solid #d9e2e7;font-weight:700;\">النوع | Type</td><td style=\"padding:10px 12px;border:1px solid #d9e2e7;\">{{ doc.type or \"\" }}</td></tr>\r\n            <tr><td style=\"padding:10px 12px;background-color:#f6f8f9;border:1px solid #d9e2e7;font-weight:700;\">الحالة | Status</td><td style=\"padding:10px 12px;border:1px solid #d9e2e7;\"><span style=\"display:inline-block;padding:3px 9px;border-radius:12px;background-color:#e8f4f7;color:#155f78;font-size:11px;font-weight:700;\">{{ doc.status or \"Open\" }}</span></td></tr>\r\n            <tr><td style=\"padding:10px 12px;background-color:#f6f8f9;border:1px solid #d9e2e7;font-weight:700;\">البداية المتوقعة | Expected Start</td><td style=\"padding:10px 12px;border:1px solid #d9e2e7;direction:ltr;text-align:left;\">{% if doc.exp_start_date %}{{ frappe.format(doc.exp_start_date, {\"fieldtype\":\"Datetime\"}) }}{% else %}Not specified{% endif %}</td></tr>\r\n            <tr><td style=\"padding:10px 12px;background-color:#f6f8f9;border:1px solid #d9e2e7;font-weight:700;\">النهاية المتوقعة | Expected End</td><td style=\"padding:10px 12px;border:1px solid #d9e2e7;direction:ltr;text-align:left;\">{% if doc.exp_end_date %}{{ frappe.format(doc.exp_end_date, {\"fieldtype\":\"Datetime\"}) }}{% else %}Not specified{% endif %}</td></tr>\r\n            <tr><td style=\"padding:10px 12px;background-color:#f6f8f9;border:1px solid #d9e2e7;font-weight:700;\">الساعات المتوقعة | Expected Hours</td><td style=\"padding:10px 12px;border:1px solid #d9e2e7;\">{{ doc.expected_time or 0 }}</td></tr>\r\n          </table>\r\n\r\n          {% if doc.description %}\r\n          <div style=\"margin-top:20px;padding:14px 16px;border:1px solid #d8e5ea;border-left:5px solid #8dc1d1;border-radius:7px;background-color:#f7fafb;\">\r\n            <div style=\"font-size:12px;font-weight:700;color:#155f78;direction:rtl;text-align:right;\">وصف المهمة | Task Description</div>\r\n            <div style=\"margin-top:7px;font-size:13px;color:#334650;\">{{ (doc.description or \"\") | e }}</div>\r\n          </div>\r\n          {% endif %}\r\n\r\n          <div style=\"margin-top:22px;padding:14px 16px;border:1px solid #e7c978;border-left:5px solid #efb43c;border-radius:7px;background-color:#fff9e8;color:#665420;font-size:12px;text-align:center;\">\r\n            <div style=\"direction:rtl;font-weight:700;\">الإجراء المطلوب: افتح المهمة، وراجع التفاصيل، وحدّث الحالة ونسبة الإنجاز أثناء التنفيذ.</div>\r\n            <div style=\"direction:ltr;margin-top:4px;\">Required action: Open the task, review its details, and keep the status and progress updated.</div>\r\n          </div>\r\n\r\n          <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"width:100%;margin-top:22px;border-collapse:collapse;\"><tr><td align=\"center\" style=\"text-align:center;\">\r\n            <a href=\"{{ task_url }}\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"display:inline-block;padding:13px 27px;border:1px solid #155f78;border-radius:7px;background-color:#155f78;color:#ffffff !important;font-family:Arial,Tahoma,sans-serif;font-size:13px;font-weight:700;line-height:1.45;text-align:center;text-decoration:none !important;box-shadow:0 3px 8px rgba(21,95,120,0.18);\">فتح المهمة ومراجعة التفاصيل<br><span style=\"font-size:11px;font-weight:600;\">Open Task and Review Details</span></a>\r\n          </td></tr></table>\r\n\r\n          <div style=\"margin-top:12px;color:#71818a;font-size:10px;line-height:1.5;text-align:center;word-break:break-all;\">\r\n            <div style=\"direction:rtl;\">إذا لم يعمل الزر، استخدم الرابط التالي:</div>\r\n            <div style=\"direction:ltr;margin-top:2px;\">If the button does not work, use the following link:</div>\r\n            <div style=\"direction:ltr;margin-top:5px;\"><a href=\"{{ task_url }}\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#155f78;text-decoration:underline;word-break:break-all;\">{{ task_url }}</a></div>\r\n          </div>\r\n\r\n          <div style=\"margin-top:25px;padding-top:16px;border-top:1px solid #dfe7eb;text-align:center;\">\r\n            <strong style=\"color:#155f78;font-size:15px;\">{{ doc.company or \"\" }}</strong>\r\n            <div style=\"margin-top:3px;color:#72818a;font-size:12px;\">إدارة المهام | Task Management</div>\r\n          </div>\r\n        </td></tr>\r\n\r\n        <tr><td style=\"padding:13px 18px;background-color:#f3f6f8;border-top:1px solid #dde5e9;text-align:center;color:#78868e;font-size:10.5px;\">\r\n          <div style=\"direction:rtl;\">إشعار آلي صادر من نظام إدارة المهام. يرجى عدم مشاركة رابط المهمة خارج فريق العمل المخول.</div>\r\n          <div style=\"direction:ltr;margin-top:2px;\">Automated Task Management notification. Please do not share the task link outside the authorized team.</div>\r\n        </td></tr>\r\n      </table>\r\n    </td></tr>\r\n  </table>\r\n</div>\r\n",
    "send_system_notification": 0,
    "recipients": [
      {
        "receiver_by_document_field": "custom_user_id"
      }
    ]
  }
]